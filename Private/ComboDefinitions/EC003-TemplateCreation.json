{
  "id": "EC003",
  "name": "Template Creation + CA Publishing",
  "description": "Principal can create new templates and publish them",
  "metadata": {
    "version": "1.0",
    "lastUpdated": "2025-10-02",
    "category": "Template Creation",
    "reference": "https://posts.specterops.io/certified-pre-owned-d95910965cd2"
  },
  "requiredCapabilities": {
    "esc5": [
      {
        "anyOf": [
          "CreateChild-CertTemplates-PKICertTemplate",
          "CreateChild-CertTemplates-AllObjects",
          "CreateChild-CertTemplates-GenericAll",
          "CreateChild-CertTemplates-GenericWrite"
        ],
        "description": "Ability to create new certificate templates"
      },
      {
        "anyOf": [
          "WriteProperty-EnrollmentService-CertTemplatesAttr", 
          "WriteProperty-EnrollmentService-AllObjects",
          "WriteProperty-EnrollmentService-GenericAll",
          "WriteProperty-EnrollmentService-GenericWrite",
          "Owner-Object"
        ],
        "description": "Ability to publish templates to CA"
      }
    ]
  },
  "steps": [
    "Create new certificate template in Certificate Templates container",
    "Configure template with ESC1 settings (no manager approval, Client Auth EKU, SAN enabled)",
    "Publish new template to Certificate Authority",
    "Enroll malicious certificate with domain admin SAN"
  ],
  "templateConfiguration": [
    {
      "setting": "Template Name",
      "value": "Custom malicious template name",
      "purpose": "Identify the created template"
    },
    {
      "setting": "msPKI-Enrollment-Flag",
      "value": "CT_FLAG_ENROLLEE_SUPPLIES_SUBJECT without CT_FLAG_PEND_ALL_REQUESTS",
      "purpose": "Allow enrollment without manager approval"
    },
    {
      "setting": "pkiExtendedKeyUsage",
      "value": "Client Authentication (1.3.6.1.5.5.7.3.2)",
      "purpose": "Enable authentication capabilities"
    },
    {
      "setting": "msPKI-Certificate-Name-Flag",
      "value": "CT_FLAG_ENROLLEE_SUPPLIES_SUBJECT_ALT_NAME",
      "purpose": "Allow custom subject alternative names"
    },
    {
      "setting": "msPKI-RA-Signature",
      "value": "0",
      "purpose": "Disable registration authority signature requirement"
    },
    {
      "setting": "Security Permissions",
      "value": "Grant Enroll permission to target users/groups",
      "purpose": "Allow enrollment by intended users"
    }
  ]
}